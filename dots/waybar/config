{
  // General bar settings
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin": "0 0 0 0",

  // Module placement
  "modules-left": [
    "sway/workspaces",
    "pulseaudio",
    "custom/rec",
    "custom/updates"
  ],
  "modules-center": [
    "clock#time"
  ],
  "modules-right": [
    "tray"
  ],

  // ----------------- Modules -----------------

  "sway/workspaces": {
    "all-outputs": false,
    "persistent_workspaces": {
      "*": [1,2,3,4,5,6,7,8,9]
    }
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}%  {icon}",
    "format-muted": "",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },

  "custom/rec": {
    "exec": "$HOME/.scripts/wf-rec-indicator",
    "interval": 1,
    "return-type": "json",
    "signal": 8,
    "on-click": "pkill --euid $USER --signal SIGINT wf-recorder",
    "tooltip": true
  },

  "clock#time": {
    "interval": 1,
    "format": "{:%A, %B %e  %I:%M %p}",
    "tooltip-format": "<tt>{:%Y-%m-%d %H:%M:%S}</tt>"
  },

  "custom/updates": {
    "exec": "$HOME/.config/waybar/updates.sh",
    "interval": 600,
    "hide-empty-text": true
  },

  "tray": {
    "icon-size": 24,
    "spacing": 8
  }
}
